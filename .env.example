# =================================================================
# ENVIRONMENT CONFIGURATION FOR VPS-INFRA (RideHub)
# Copy this file to .env: cp .env.example .env
# =================================================================

# Domain Configuration
DOMAIN=phungvip.io.vn

# General Master Password (used for Redis, Consul token, Grafana pass, Kafka SSL keystore)
APP_F4_PASS=f4security

# Keycloak Administrator Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak OIDC Client (used by Nginx Lua proxy for Kafdrop, Consul, RedisInsight)
OIDC_CLIENT_ID=web_app
OIDC_CLIENT_SECRET=0TnpRknqjQYngbnbRW7hKECA8TbR4D7V

# Grafana Admin
GRAFANA_ADMIN_USER=admin

# Cloudflare Tunnel Configuration
# Tunnel is managed via ./central-server-config/cloudflared/config.yml and ./central-server-config/cloudflared/credentials.json

# Cloudflare Zero Trust Access Configuration (for setup-cloudflare-access.sh)
CF_API_TOKEN=your_cloudflare_api_token
# CF_ACCOUNT_ID=  # (tự động nhận diện từ credentials.json)

# Service-to-Service & Kafka OAuth (Bootstrap Client in jhipster-realm)
S2S_CLIENT_ID=svc-admin-bootstrap
S2S_CLIENT_SECRET=EB4eohc7BEY3tw1Rjg7FS8xMLfi95n0n

# External APIs (Optional)
ZAI_API_KEY=
GRAPHHOPPER_API_KEY=

# VNPay Configuration
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://apigateway.phungvip.io.vn/services/msbooking/api/payment/vnpay/callback

# MoMo Configuration
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=https://apigateway.phungvip.io.vn/services/msbooking/api/momo/return
MOMO_NOTIFY_URL=https://apigateway.phungvip.io.vn/services/msbooking/api/momo/notify

# ZaloPay Configuration
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=https://apigateway.phungvip.io.vn/services/msbooking/api/zalopay/callback



