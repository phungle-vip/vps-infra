# =================================================================
# ENVIRONMENT CONFIGURATION FOR VPS-INFRA (RideHub)
# Copy this file to .env: cp .env.example .env
# =================================================================

# Domain & Host Configuration
DOMAIN=yourdomain.com
VPS_HOST=yourdomain.com
VPS_USER=root
VPS_PASSWORD=your_vps_password
TZ=Asia/Ho_Chi_Minh

# General Master Password (used for Kafka SSL keystore, initial secrets)
APP_F4_PASS=your_master_password

# Core Infrastructure Tokens
CONSUL_MASTER_TOKEN=your_consul_master_token
VAULT_DEV_ROOT_TOKEN_ID=your_vault_root_token
VAULT_TOKEN=your_vault_token
ADMIN_TOKEN=your_admin_token

# Database
SQL_HOST=127.0.0.1
SQL_PORT=3306

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Keycloak Administrator Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password

# Keycloak Realm User Passwords (jhipster realm)
KC_PASS_ADMIN_PHUNGVIP=your_admin_phungvip_password
KC_PASS_DEVOPS_LEAD=your_devops_lead_password
KC_PASS_DEV=your_dev_password
KC_PASS_QA=your_qa_password
KC_PASS_MANAGER=your_manager_password
KC_PASS_STAFF=your_staff_password
KC_PASS_DRIVER=your_driver_password
KC_PASS_USER=your_user_password

# Keycloak Issuer URI
KEYCLOAK_ISSUER_URI=https://keycloak.yourdomain.com/realms/jhipster

# Keycloak OIDC Client (used by Nginx Lua proxy & microservices)
CLIENT_ID=web_app
CLIENT_SECRET=your_oidc_client_secret
OIDC_CLIENT_ID=web_app
OIDC_CLIENT_SECRET=your_oidc_client_secret

# Service-to-Service & Kafka OAuth (Bootstrap Client in jhipster-realm)
S2S_CLIENT_ID=svc-admin-bootstrap
S2S_CLIENT_SECRET=your_s2s_client_secret

# Schema Registry
SCHEMA_REGISTRY_URL=http://yourdomain.com:8081

# Reposilite Maven Repository
REPOSILITE_USER=admin
REPOSILITE_TOKEN=your_reposilite_token

# Grafana Admin & OIDC
GRAFANA_ADMIN_USER=admin
GRAFANA_OIDC_CLIENT_SECRET=your_oidc_client_secret

# Cloudflare Zero Trust & Tunnel (Cloudflare-First)
TUNNEL_TOKEN=
CF_API_TOKEN=your_cloudflare_api_token
CF_ACCOUNT_ID=your_cloudflare_account_id

# External APIs (Optional)
ZAI_API_KEY=
GRAPHHOPPER_API_KEY=

# VNPay Configuration
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=https://apigateway.yourdomain.com/services/msbooking/api/payment/vnpay/callback

# MoMo Configuration
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=https://apigateway.yourdomain.com/services/msbooking/api/momo/return
MOMO_NOTIFY_URL=https://apigateway.yourdomain.com/services/msbooking/api/momo/notify

# ZaloPay Configuration
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=https://apigateway.yourdomain.com/services/msbooking/api/zalopay/callback



